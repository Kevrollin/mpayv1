# Supabase project settings (Project Settings > API in the Supabase dashboard)
# These are safe to expose in a client bundle — the anon key is designed for
# this, and access is enforced server-side by Row Level Security (RLS).
# NEVER put a service_role key in a frontend project.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Leave the two above unset to run entirely on the local mock backend
# (src/lib/mockBackend.js) — no Supabase project needed for local testing.

# Passphrase for the local-only /admin viewer. Not real access control —
# just a UX gate for your own dev use. Change it from the default below.
VITE_ADMIN_PASSPHRASE=admin123
